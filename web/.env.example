# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets. Copy to .env.local and fill in.
# If they are blank the site still works; sign-in is just unavailable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only: set to 1 to use the Auth and Firestore emulators
# (`firebase emulators:start --project demo-flamemind` from the repo root).
NEXT_PUBLIC_FIREBASE_EMULATORS=

# The FlameMind API (api/). Used by the chat page. For local development: http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=
