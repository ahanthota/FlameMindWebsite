{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/landing.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "cd .. && firebase emulators:exec --only firestore --project demo-flamemind \"npm --prefix web run test:rules:run\"",
    "test:rules:run": "vitest run --config vitest.rules.config.mts"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "next": "16.4.6",
    "plotly.js": "^4.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-plotly.js": "^4.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-plotly.js": "^2.6.4",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
