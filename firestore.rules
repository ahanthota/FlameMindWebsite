rules_version = '2';

// User data only. Science data is never stored in Firestore.
//
//   users/{uid}                               profile, owner read/write
//   users/{uid}/chats/{chatId}                written by the API; owner may rename or delete
//   users/{uid}/chats/{chatId}/messages/{id}  written by the API; owner may delete
//   users/{uid}/savedFilters/{id}             owner read/write
//
// The API uses a service account, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'email', 'createdAt', 'useCaseProfile'])
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('useCaseProfile' in data) || data.useCaseProfile == null || validUseCase(data.useCaseProfile));
    }

    function validUseCase(useCase) {
      return useCase is map
        && useCase.keys().hasOnly(['description', 'habitat', 'goal', 'materials', 'constraints'])
        && (!('description' in useCase) || useCase.description == null
            || (useCase.description is string && useCase.description.size() <= 2000));
    }

    function validSavedFilter(data) {
      return data.keys().hasOnly(['name', 'manualFilters', 'customFilters', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.manualFilters is map
        && data.customFilters is list && data.customFilters.size() <= 20;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      // createdAt is set once.
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

      match /chats/{chatId} {
        allow read, delete: if isOwner(uid);
        allow create: if false;
        // Rename only: the title is the one field the owner may change.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120;

        match /messages/{messageId} {
          // Deleting a chat (or the account) removes its messages. Nothing else is allowed.
          allow read, delete: if isOwner(uid);
          allow create, update: if false;
        }
      }

      match /savedFilters/{filterId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSavedFilter(request.resource.data);
      }
    }
  }
}
